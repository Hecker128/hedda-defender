[Version]
Signature="$WINDOWS NT$"
Class=AntiVirus
ClassGuid={b1d1a169-c54f-4379-81db-bee7d88d7454}
Provider=Hecker128
DriverVer=
CatalogFile=HeddaFlt.cat
PnpLockdown=1

[DestinationDirs]
HeddaFlt.DriverFiles=13

[DefaultInstall.NTamd64]
CopyFiles=HeddaFlt.DriverFiles

[DefaultInstall.NTamd64.Services]
AddService=HeddaFlt,,HeddaFlt.Service

[HeddaFlt.Service]
DisplayName=HeddaFlt
ServiceBinary=%13%\HeddaFlt.sys
ServiceType=2
StartType=3
ErrorControl=1
LoadOrderGroup="FSFilter Anti-Virus"
AddReg=HeddaFlt.AddRegistry
Dependencies=FltMgr

[HeddaFlt.AddRegistry]
HKR,"Parameters","SupportedFeatures",0x0010001,0x7 ; SUPPORTED_FS_FEATURES_OFFLOAD_READ | SUPPORTED_FS_FEATURES_OFFLOAD_WRITE | SUPPORTED_FS_FEATURES_QUERY_OPEN (TODO: Another flag was added in Windows 11. Maybe add that)
HKR,"Parameters\Instances","DefaultInstance",0x0000000,"HeddaFltInstance"
HKR,"Parameters\Instances\HeddaFltInstance","Altitude",0x0000000,"320069",
HKR,"Parameters\Instances\HeddaFltInstance","Flags",0x0010001,0x01
; TODO: "Parameters","PreventPagingFileAbuse" is set to REG_DWORD 0x1 in WdFilter (from Windows defender). Maybe set that?

[SourceDisksFiles]
HeddaFlt.sys=1

[SourceDisksNames]
1="HeddaFlt SAUCE Disk"

[HeddaFlt.DriverFiles]
HeddaFlt.sys